+class CPU4ObservationTests(unittest.TestCase):
+    @staticmethod
+    def stat(start=123, user=50, system=7):
+        fields = ["R"] + ["0"] * 51
+        fields[11], fields[12], fields[19] = str(user), str(system), str(start)
+        return "101 (fake thread) " + " ".join(fields)
+
+    def tasks(self, count=4, *, changed_start=False, mask=None, disappeared=False):
+        scan = Mock()
+        scan.__enter__ = Mock(
+            return_value=iter(types.SimpleNamespace(name=str(100 + n)) for n in range(count))
+        )
+        scan.__exit__ = Mock(return_value=False)
+        stats = 0
+
+        def text(path):
+            nonlocal stats
+            if path.name == "status":
+                return "Cpus_allowed_list:\t16-19\n"
+            self.assertEqual(path.name, "stat")
+            if disappeared:
+                raise FileNotFoundError("fake exited task")
+            stats += 1
+            return self.stat(start=123 + int(changed_start and stats % 2 == 0))
+
+        with (
+            patch.object(run.os, "scandir", return_value=scan),
+            patch.object(run, "small_kernel_text", side_effect=text),
+            patch.object(run.os, "sched_getaffinity", return_value=mask or set(run.CPU_CORES)),
+            patch.object(run.os, "sysconf", return_value=100),
+        ):
+            return run.task_affinities(999)
+
+    def test_native_argv_changes_only_requested_threads_in_all_three_arms(self):
+        native = {"path": "/FAKE-native"}
+        package = {"model": {"path": "/FAKE-model"}, "mmproj": {"path": "/FAKE-projector"}}
+        for context, full in ((2048, True), (2048, False), (8192, False)):
+            argv = run.native_argv(native, package, context, full)
+            self.assertEqual(
+                argv,
+                [
+                    "/FAKE-native",
+                    "--model",
+                    "/FAKE-model",
+                    "--mmproj",
+                    "/FAKE-projector",
+                    "--ctx-size",
+                    str(context),
+                    "--batch-size",
+                    "512",
+                    "--threads",
+                    "4",
+                    "--gpu-layers",
+                    "0",
+                    "--swa-full",
+                    "1" if full else "0",
+                    "--cpu-mmap-only",
+                    "1",
+                ],
+            )
+
+    def test_four_task_observations_retain_dual_masks_and_cpu_ticks(self):
+        row = self.tasks()
+        self.assertEqual(row["retained_task_count"], 4)
+        self.assertEqual(row["task_population_observed_at_least"], 4)
+        self.assertEqual(row["observation_errors"], [])
+        for task in row["records"]:
+            self.assertEqual(task["sched_before"], [16, 17, 18, 19])
+            self.assertEqual(task["sched_after"], task["sched_before"])
+            self.assertTrue(task["matches_selected_mask_in_both_interfaces"])
+            self.assertEqual((task["user_ticks"], task["system_ticks"]), (50, 7))
+
+    def test_widened_task_mask_is_recorded_without_universal_affinity_claim(self):
+        row = self.tasks(mask=set(range(20)))
+        self.assertEqual(row["records"][0]["sched_after"], list(range(20)))
+        self.assertFalse(row["records"][0]["matches_selected_mask_in_both_interfaces"])
+
+    def test_task_population_bound_and_transient_identity_errors_remain_visible(self):
+        row = self.tasks(count=1000)
+        self.assertEqual(row["retained_task_count"], 64)
+        self.assertEqual(row["task_population_observed_at_least"], 65)
+        self.assertTrue(row["enumeration_truncated"])
+        for kwargs in ({"changed_start": True}, {"disappeared": True}):
+            row = self.tasks(count=1, **kwargs)
+            self.assertEqual(row["records"], [])
+            self.assertEqual(len(row["observation_errors"]), 1)
+
+    def cpu_stat(self, *, raw=None, changed=False):
+        own = "0::/FAKE-parent/" + run.OWNER_UNIT
+        count = 0
+        text = (
+            raw
+            or "usage_usec 8000000\nuser_usec 7000000\nsystem_usec 1000000\nnr_periods 20\nnr_throttled 2\nthrottled_usec 100\n"
+        )
+
+        def read(path):
+            nonlocal count
+            if path == Path("/proc/self/cgroup"):
+                count += 1
+                return own + ("-changed" if changed and count == 2 else "")
+            self.assertEqual(path, Path("/sys/fs/cgroup/FAKE-parent") / run.OWNER_UNIT / "cpu.stat")
+            return text
+
+        with (
+            patch.object(run, "small_kernel_text", side_effect=read),
+            patch.object(run.time, "monotonic", return_value=100),
+        ):
+            return run.owned_cpu_stat()
+
+    def test_cpu_stat_reads_only_own_unified_group_and_keeps_throttling(self):
+        row = self.cpu_stat()
+        self.assertEqual(row["cgroup"], "0::/FAKE-parent/" + run.OWNER_UNIT)
+        self.assertEqual(row["counters"]["usage_usec"], 8000000)
+        self.assertEqual(row["counters"]["nr_throttled"], 2)
+        self.assertEqual(row["counters"]["throttled_usec"], 100)
+        with self.assertRaisesRegex(ValueError, "Stable own cgroup"):
+            self.cpu_stat(changed=True)
+        with self.assertRaisesRegex(ValueError, "distinct numeric"):
+            self.cpu_stat(raw="usage_usec 1\nusage_usec 2\n")
+        with self.assertRaisesRegex(ValueError, "Stable own cgroup"):
+            self.cpu_stat(raw="usage_usec 1\n")
+
+    def test_cpu_delta_quantifies_aggregate_cores_and_refuses_reset_or_foreign_group(self):
+        after = self.cpu_stat()
+        before = {
+            **after,
+            "observed_monotonic": 98,
+            "counters": {key: 0 for key in after["counters"]},
+        }
+        delta = run.cpu_stat_delta(before, after)
+        self.assertEqual(delta["average_cpu_cores"], 4)
+        self.assertEqual(delta["counter_deltas"]["nr_throttled"], 2)
+        with self.assertRaisesRegex(ValueError, "Same own cgroup"):
+            run.cpu_stat_delta({**before, "cgroup": "0::/FOREIGN"}, after)
+        with self.assertRaisesRegex(ValueError, "Forward CPU snapshots"):
+            run.cpu_stat_delta(after, before)
+
+
 if __name__ == "__main__":
     unittest.main(verbosity=2)
