+class DeadlineScope:
+    """Keep an existing primary when watchdog cancellation also fails."""
+
+    def __init__(self, deadline):
+        self.deadline = deadline
+
+    def __enter__(self):
+        return self.deadline.__enter__()
+
+    def __exit__(self, kind, primary, traceback):
+        try:
+            result = self.deadline.__exit__(kind, primary, traceback)
+        except BaseException as secondary:
+            if primary is None:
+                raise
+            primary.add_note("Deadline cleanup also failed: " + repr(secondary))
+            return False
+        return False if primary is not None else result
+
