+                self.stage = stage
+                timers.append((stage, seconds))
+
+            def __enter__(self):
+                return self
+
+            def __exit__(self, *_args):
+                clock.now += advances.get(self.stage, 0)
+                if self.stage in cleanup:
+                    raise cleanup[self.stage]
